{
  "name": "bay-area-megaprojects",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive 3D map of the Bay Area's largest development projects.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "glyphs": "node scripts/build-glyphs.mjs",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "e2e": "playwright test tests/interaction.spec.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "preact": "11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fontnik": "0.7.7",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
